NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-api-key
NEXT_PUBLIC_AMOY_RPC_URL=https://polygon-amoy.infura.io/v3/your-api-key

NEXT_PUBLIC_V2_SEPOLIA_MARKETPLACE_ADDRESS=0x3d08d1549aBD309a124a3C77CbE8bCc39a0eB366
NEXT_PUBLIC_V2_SEPOLIA_VAULT_ADDRESS=0x4F2350154A34d8D87013Cab3E1001311186fb839
NEXT_PUBLIC_V2_AMOY_MARKETPLACE_ADDRESS=0xC8141a88633fa08121E6B9244e5d1Ad1a441FcfD
NEXT_PUBLIC_V2_AMOY_VAULT_ADDRESS=0xdCeD6FC8cF7CEF86b630f1978d0B78655d103f1E

# V3.2 stablecoin lane on Arbitrum Sepolia (parallel to V3.1 native lane).
NEXT_PUBLIC_V3_2_ARBITRUMSEPOLIA_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_V3_2_ARBITRUMSEPOLIA_REPUTATION_ADDRESS=
NEXT_PUBLIC_V3_2_ARBITRUMSEPOLIA_MOCK_USD_ADDRESS=

DATABASE_URL="file:./dev.db"

# Optional indexer tuning.
INDEXER_POLL_INTERVAL_MS=15000
INDEXER_CHUNK_SIZE_BLOCKS=5000
INDEXER_REQUEST_DELAY_MS=75

# Optional. Enables local image upload through /api/upload-image.
# Without this, seller forms fall back to pasting an external image URL.
IMGBB_API_KEY=

# Dispute evidence storage.
# Files are stored privately and served only through the auth-gated
# /api/evidence/files/[id] endpoint (buyer/seller/admin/Kleros juror).
# Public IPFS is intentionally NOT used — see contracts/v3/ARCHITECTURE.md.
#
# STORAGE_BACKEND=local stores files on the local filesystem (default,
#   good for dev/self-hosted). EVIDENCE_STORAGE_DIR overrides the directory
#   (default ./evidence-uploads).
# STORAGE_BACKEND=r2 uses Cloudflare R2 (S3-compatible, free 10GB, no egress
#   fees). Requires the R2_* env vars below. Setup steps:
#     1. Sign up at cloudflare.com → R2 → Create bucket "chainus-evidence"
#     2. R2 → Manage API Tokens → Create → permissions: Object Read & Write,
#        scope: only this bucket. Copy the Access Key ID + Secret (shown once).
#     3. Account ID is in the R2 sidebar — endpoint is
#        https://<account_id>.r2.cloudflarestorage.com
STORAGE_BACKEND=local
EVIDENCE_STORAGE_DIR=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Comma-separated wallet addresses that can view ANY evidence (platform
# admins / support). Leave empty in production unless you actually need it.
EVIDENCE_ADMIN_ADDRESSES=

# Kleros adapter address per chain — used by the evidence viewer to look up
# the dispute's drawn jurors and grant them read access.
NEXT_PUBLIC_KLEROS_ADAPTER_ARBITRUMSEPOLIA_ADDRESS=

# V3.1 single-sig smoke testing only.
# Set to "true" only on testnet to show the "Bypass LI.FI bridge" checkbox.
# Never enable this in production: the relayer pays msg.value from its own balance.
NEXT_PUBLIC_V3_1_TESTNET_BYPASS=

# V3.1 EvidenceRegistry instance (separate from V3's, deployed via
# scripts/deployEvidenceRegistryV3_1.ts). Set BOTH the public and
# server-only forms to the same address. If unset, the V3.1 order detail
# page shows "registry not deployed" and the submit dialog is disabled
# for V3.1 orders.
NEXT_PUBLIC_V3_1_ARBITRUMSEPOLIA_EVIDENCE_REGISTRY_ADDRESS=
V3_1_ARBITRUMSEPOLIA_EVIDENCE_REGISTRY_ADDRESS=

# Optional notifications. Without RESEND_API_KEY, indexer records skipped EmailLog rows and keeps running.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
APP_BASE_URL=http://localhost:3000
PLATFORM_OWNER_EMAIL=
