generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  sellerAddress String
  name          String
  description   String   @default("")
  priceWei      String
  chainId       Int
  imageUrl      String   @default("")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sellerAddress])
  @@index([chainId, status])
}

model OnChainOrder {
  id                Int       @id @default(autoincrement())
  chainId           Int
  onChainOrderId    String
  buyer             String
  seller            String
  productId         String
  amountWei         String
  status            String
  createdAt         DateTime?
  paidAt            DateTime?
  shippedAt         DateTime?
  completedAt       DateTime?
  refundedAt        DateTime?
  disputedAt        DateTime?
  lastBlock         BigInt
  lastLogIndex      Int       @default(0)
  lastTxHash        String
  lastSyncedAt      DateTime  @default(now())
  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  shippingNote      String?
  shippingUpdatedAt DateTime?

  @@unique([chainId, onChainOrderId])
  @@index([buyer])
  @@index([seller])
  @@index([status])
  @@index([chainId])
}

model IndexerState {
  chainId   Int      @id
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}

model User {
  walletAddress String   @id
  email         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
}

model EmailLog {
  id             Int      @id @default(autoincrement())
  toAddress      String
  toEmail        String
  kind           String
  chainId        Int
  onChainOrderId String
  status         String
  error          String?
  createdAt      DateTime @default(now())

  @@index([toAddress, kind, onChainOrderId])
  @@index([createdAt])
}

model TrackingSnapshot {
  id             Int       @id @default(autoincrement())
  chainId        Int
  onChainOrderId String
  trackingNumber String
  // Normalised status: "Delivered" / "InTransit" / "Pickup" / "Undelivered" /
  // "Expired" / "Exception" / "Unknown".
  status         String
  // 17track raw status_code (0/10/20/30/35/40/50).
  statusCode     Int
  latestEventAt  DateTime?
  // JSON: [{ time: ISO string, description: string, location: string|null, statusCode: number }]
  events         Json
  lastFetchedAt  DateTime  @default(now())

  @@unique([chainId, onChainOrderId])
  @@index([lastFetchedAt])
}

// Per-evidence record. One row per ERC-1497 Evidence event emitted by
// EvidenceRegistryV3. Includes optional oracle query result when the
// submission used submitEvidenceWithOracleQuery and the DON callback has
// arrived.
model Evidence {
  id                             Int      @id @default(autoincrement())
  chainId                        Int
  onChainOrderId                 String
  evidenceIndex                  Int
  party                          String
  evidenceURI                    String
  contentHash                    String
  marketplaceDeliveredAtSnapshot BigInt
  submittedAt                    DateTime
  submittedBlock                 BigInt
  submittedTxHash                String

  oracleRequestId          String?
  oracleQueryStatus        String?
  oracleDelivered          Boolean?
  oracleDeliveredTimestamp BigInt?
  oracleError              String?
  oracleFulfilledAt        DateTime?
  oracleFulfilledBlock     BigInt?
  oracleFulfilledTxHash    String?

  @@unique([chainId, onChainOrderId, evidenceIndex])
  @@index([chainId, onChainOrderId])
  @@index([party])
  @@index([oracleQueryStatus])
}
