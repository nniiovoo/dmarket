generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  sellerAddress String
  name          String
  description   String   @default("")
  priceWei      String
  chainId       Int
  imageUrl      String   @default("")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Generated tsvector for full-text search. Postgres maintains this
  /// automatically via GENERATED ALWAYS AS in
  /// prisma/migrations/manual_product_search.sql — DO NOT write from
  /// Prisma. Query path is raw SQL only; this field exists in the
  /// model so Prisma's introspect / generate doesn't drop the column.
  searchVector  Unsupported("tsvector")?

  @@index([sellerAddress])
  @@index([chainId, status])
  @@index([searchVector], type: Gin)
}

model OnChainOrder {
  id                Int       @id @default(autoincrement())
  chainId           Int
  onChainOrderId    String
  buyer             String
  seller            String
  productId         String
  amountWei         String
  status            String
  createdAt         DateTime?
  paidAt            DateTime?
  shippedAt         DateTime?
  completedAt       DateTime?
  refundedAt        DateTime?
  disputedAt        DateTime?
  lastBlock         BigInt
  lastLogIndex      Int       @default(0)
  lastTxHash        String
  lastSyncedAt      DateTime  @default(now())
  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  shippingNote      String?
  shippingUpdatedAt DateTime?

  @@unique([chainId, onChainOrderId])
  @@index([buyer])
  @@index([seller])
  @@index([status])
  @@index([chainId])
}

model IndexerState {
  chainId   Int      @id
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}

// Mirror of OnChainOrder for V3.1 marketplace. V3 and V3.1 have separate
// orderId counters and share zero data on-chain, so we keep them physically
// separated in the DB rather than overload a `version` column on OnChainOrder.
model OnChainOrderV3_1 {
  id                Int       @id @default(autoincrement())
  chainId           Int
  onChainOrderId    String
  buyer             String
  seller            String
  productId         String
  amountWei         String
  status            String
  createdAt         DateTime?
  paidAt            DateTime?
  shippedAt         DateTime?
  completedAt       DateTime?
  refundedAt        DateTime?
  disputedAt        DateTime?
  lastBlock         BigInt
  lastLogIndex      Int       @default(0)
  lastTxHash        String
  lastSyncedAt      DateTime  @default(now())
  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  shippingNote      String?
  shippingUpdatedAt DateTime?

  @@unique([chainId, onChainOrderId])
  @@index([buyer])
  @@index([seller])
  @@index([status])
  @@index([chainId])
}

// Per-chain catch-up cursor for the V3.1 indexer. Separate from
// IndexerState so V3.1 can lag/lead V3 independently.
model IndexerStateV3_1 {
  chainId   Int      @id
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}

// V3.2 orders live in a parallel marketplace (`EscrowMarketplaceERC20`) that
// custodies funds itself and carries an ERC-20 payment token per order. The
// model is intentionally NOT a subclass / reuse of OnChainOrderV3_1:
//   - v3.2 adds `paymentToken`; making the v3.1 column nullable would force
//     every reader to branch on "is this v3.2 in disguise?", losing the
//     clarity the typed models give us.
//   - the unique key is `(chainId, marketplaceAddress, onChainOrderId)` —
//     v3 and v3.2 share an orderId space, so the v3.1-style two-column key
//     would collide. Carrying the marketplace address explicitly removes
//     the ambiguity for the lifetime of the row.
//   - status is an Int (matches the on-chain enum 0..6) rather than a label
//     string; downstream code can reuse the existing OrderStatus enum
//     without a parser. The trade-off is a 1-arg integer in DB tools, but
//     mappings are stable and small.
// No cascade delete: order rows are an audit artefact and should outlive
// product / user deletions.
model OnChainOrderV3_2 {
  id                 String    @id @default(cuid())
  chainId            Int
  marketplaceAddress String
  onChainOrderId     String
  buyer              String
  seller             String
  paymentToken       String // address(0) for native; else ERC-20 address
  productId          String
  amount             String // wei (native) or token base units (ERC-20)
  status             Int // 0..6 (Created / Paid / Shipped / Completed / Cancelled / Disputed / Refunded)
  createdAt          DateTime
  paidAt             DateTime?
  shippedAt          DateTime?
  completedAt        DateTime?
  disputedAt         DateTime?
  // Kleros V2 adapter mirror columns (Phase H.3). All nullable; populated
  // by the independent adapter event indexer. `klerosDisputeId` is stored
  // as TEXT because Kleros disputeIds are uint256; we never do numeric
  // comparisons in SQL on it.
  klerosDisputeId    String?
  disputeEscalatedAt DateTime?
  klerosRuling       Int? // 0 = refused → buyer (normalised), 1 = buyer, 2 = seller
  klerosRuledAt      DateTime?
  lastEventBlock     BigInt
  lastEventTxHash    String
  lastSyncedAt       DateTime  @default(now())

  @@unique([chainId, marketplaceAddress, onChainOrderId])
  @@index([buyer])
  @@index([seller])
  @@index([chainId, marketplaceAddress])
  @@index([klerosDisputeId])
}

// Per-(chain, marketplace) catch-up cursor for the V3.2 indexer. Keyed on
// the marketplace address as well so a future second v3.2 deployment on
// the same chain (or a re-deploy after testing) doesn't share state.
model IndexerStateV3_2 {
  chainId            Int
  marketplaceAddress String
  lastBlock          BigInt
  lastLogIndex       Int      @default(-1)
  updatedAt          DateTime @updatedAt

  @@id([chainId, marketplaceAddress])
}

// Cursor for the v3.2 Kleros adapter indexer. Independent stream from the
// marketplace indexer because the adapter is a separate contract address
// with its own event stream and its own re-deploy lifecycle.
model IndexerStateV3_2KlerosAdapter {
  chainId          Int
  adapterAddress   String
  lastIndexedBlock BigInt
  updatedAt        DateTime @updatedAt

  @@id([chainId, adapterAddress])
}

// Signed reputation attestations issued by the platform attestor and
// (eventually) recorded on-chain via ReputationRegistry.recordAttestation.
// One row per (subject, version) pair — version is monotonic per subject
// in the contract, so the unique constraint here mirrors the on-chain
// replay-prevention invariant. The row may exist with txHash=null when an
// attestation has been signed but not yet published.
model PublishedAttestation {
  id           String    @id @default(cuid())
  subject      String // lowercased seller address
  score        Int
  issuedAt     DateTime
  expiry       DateTime
  version      Int
  signature    String
  chainId      Int
  registryAddr String // checksummed
  txHash       String?
  publishedAt  DateTime?

  @@unique([subject, version])
  @@index([subject])
}

// Sellers flagged by the indexer for an out-of-band reputation refresh
// (after Completed / Refunded / DisputeResolved). The cron sweeps this
// table, runs computeSellerScore + issueAttestation + publishAttestation,
// then writes processedAt to signal completion. processedAt=null means
// "still pending".
model ReputationRefreshQueue {
  subject     String    @id // lowercased seller address
  queuedAt    DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt])
}

model User {
  walletAddress String   @id
  email         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
}

model EmailLog {
  id                 Int      @id @default(autoincrement())
  toAddress          String
  toEmail            String
  kind               String
  chainId            Int
  onChainOrderId     String
  // "v3" or "v3.1". Distinguishes V3 and V3.1 marketplaces — they have
  // independent orderId counters, so without this column the 24h dedup
  // key collides (V3 #3 and V3.1 #3 are unrelated orders).
  marketplaceVersion String   @default("v3")
  status             String
  error              String?
  createdAt          DateTime @default(now())

  @@index([toAddress, kind, chainId, onChainOrderId, marketplaceVersion])
  @@index([createdAt])
}

model TrackingSnapshot {
  id             Int       @id @default(autoincrement())
  chainId        Int
  onChainOrderId String
  trackingNumber String
  // Normalised status: "Delivered" / "InTransit" / "Pickup" / "Undelivered" /
  // "Expired" / "Exception" / "Unknown".
  status         String
  // 17track raw status_code (0/10/20/30/35/40/50).
  statusCode     Int
  latestEventAt  DateTime?
  // JSON: [{ time: ISO string, description: string, location: string|null, statusCode: number }]
  events         Json
  lastFetchedAt  DateTime  @default(now())

  @@unique([chainId, onChainOrderId])
  @@index([lastFetchedAt])
}

// Per-evidence record. One row per ERC-1497 Evidence event emitted by
// EvidenceRegistryV3. Includes optional oracle query result when the
// submission used submitEvidenceWithOracleQuery and the DON callback has
// arrived.
model Evidence {
  id                             Int      @id @default(autoincrement())
  chainId                        Int
  onChainOrderId                 String
  evidenceIndex                  Int
  party                          String
  evidenceURI                    String
  contentHash                    String
  marketplaceDeliveredAtSnapshot BigInt
  submittedAt                    DateTime
  submittedBlock                 BigInt
  submittedTxHash                String

  oracleRequestId          String?
  oracleQueryStatus        String?
  oracleDelivered          Boolean?
  oracleDeliveredTimestamp BigInt?
  oracleError              String?
  oracleFulfilledAt        DateTime?
  oracleFulfilledBlock     BigInt?
  oracleFulfilledTxHash    String?

  @@unique([chainId, onChainOrderId, evidenceIndex])
  @@index([chainId, onChainOrderId])
  @@index([party])
  @@index([oracleQueryStatus])
}

// Uploaded evidence files. Bytes live in our storage backend (local FS in
// dev, R2/S3 in prod); the public URL returned to the user resolves through
// /api/evidence/files/[id] which is auth-gated. The on-chain submitEvidence
// call only commits the contentHash (keccak256 of file bytes), so the file
// can be replaced server-side only if the hash matches.
model EvidenceUpload {
  id                 String   @id // 32-byte random, URL-safe
  chainId            Int
  onChainOrderId     String
  marketplaceVersion String   @default("v3")
  contentHash        String // 0x-prefixed keccak256 hex of file bytes
  storageKey         String // path/key within the storage backend
  storageBackend     String // "local" | "r2" | "s3"
  fileName           String
  contentType        String
  size               Int
  uploadedBy         String // lowercased wallet address
  createdAt          DateTime @default(now())

  @@index([chainId, onChainOrderId, marketplaceVersion])
  @@index([contentHash])
  @@index([uploadedBy])
}

// One-time SIWE nonces. We hand out a fresh nonce on /auth/siwe/nonce and
// invalidate it on first /auth/siwe/verify. Stops replay of captured
// SIWE messages.
model SiweNonce {
  nonce     String    @id
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([createdAt])
}

// Active SIWE sessions. The session ID lives in an HttpOnly cookie; the row
// here lets us revoke without touching the cookie (set expiresAt to past).
model AuthSession {
  id         String   @id // 32-byte random, URL-safe
  address    String // lowercased
  issuedAt   DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  @@index([address])
  @@index([expiresAt])
}

// DEPRECATED as of the unified messenger refactor. Rows are kept readable
// for audit / migration but the UI no longer mounts the per-order chat
// panel. New chats go through the Conversation / ConversationMessage
// tables below, which scope a thread to a (buyer, seller) pair rather
// than to a single order.
//
// Original purpose:
// Per-order private chat between buyer and seller. Platform admins
// (EVIDENCE_ADMIN_ADDRESSES env) can read but not write — admin support
// shouldn't be able to impersonate either party. Messages don't touch the
// chain; this is purely Web2 support context that can be referenced as
// supplementary evidence in a future dispute.
//
// Attachments: optional single image per message. Bytes live in the same
// storage backend as evidence (local FS or R2), served behind the gated
// /api/orders/[chainId]/[orderId]/chat/[messageId]/file endpoint. Keeping
// the columns nullable lets old text-only messages coexist without
// migration of their data.
model OrderChatMessage {
  id                 String   @id // 32-byte base64url
  chainId            Int
  onChainOrderId     String
  // "v3" or "v3.1". Same reason as EmailLog.marketplaceVersion: V3 #N and
  // V3.1 #N are unrelated orders, so the (chainId, orderId) key alone isn't
  // enough to identify a chat thread.
  marketplaceVersion String   @default("v3")
  senderAddress      String // lowercased
  body               String   @db.Text // up to ~8KB chat message
  createdAt          DateTime @default(now())

  attachmentKey         String?
  attachmentBackend     String? // "local" | "r2"
  attachmentContentType String?
  attachmentFileName    String?
  attachmentSize        Int?

  @@index([chainId, onChainOrderId, marketplaceVersion, createdAt])
  @@index([senderAddress])
}

// DEPRECATED — see OrderChatMessage above. Retained for audit only.
model OrderChatLastSeen {
  walletAddress      String // lowercased
  chainId            Int
  onChainOrderId     String
  marketplaceVersion String   @default("v3")
  lastSeenAt         DateTime @default(now())

  @@id([walletAddress, chainId, onChainOrderId, marketplaceVersion])
  @@index([walletAddress, lastSeenAt])
}

// Direct conversation between two wallets on one chain. Replaces the
// per-order chat surface above. One row per (chainId, participantA,
// participantB) pair — participantA is always the lexicographically
// smaller lowercased address so the unique constraint catches duplicate
// inserts regardless of who initiated.
//
// initialProductId is a *hint*, not a scoping key: it records "this
// conversation started from product page #X" so the UI can show context
// in the header. Subsequent messages aren't tied to that product — if
// the buyer asks about a different product in the same thread, the
// thread doesn't fork.
model Conversation {
  id               String   @id // 32-byte base64url
  chainId          Int
  participantA     String // lowercased, lexicographically smaller of the pair
  participantB     String // lowercased, the other one
  initialProductId String? // optional product context recorded at creation time
  createdAt        DateTime @default(now())
  // Bumped on every send. Drives the conversation list sort order in the
  // messenger sidebar without needing a window function.
  lastMessageAt    DateTime @default(now())

  messages ConversationMessage[]

  @@unique([chainId, participantA, participantB])
  @@index([participantA, lastMessageAt])
  @@index([participantB, lastMessageAt])
}

// One message within a Conversation. Attachment columns mirror
// OrderChatMessage so the storage helper can be reused unchanged.
model ConversationMessage {
  id                    String   @id // 32-byte base64url
  conversationId        String
  senderAddress         String // lowercased
  body                  String   @db.Text
  attachmentKey         String?
  attachmentBackend     String? // "local" | "r2"
  attachmentContentType String?
  attachmentFileName    String?
  attachmentSize        Int?
  createdAt             DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderAddress])
}

// Per-user read cursor for a conversation. /api/conversations uses this to
// compute the unread count shown on the sidebar / nav badge.
model ConversationLastSeen {
  walletAddress  String // lowercased
  conversationId String
  lastSeenAt     DateTime @default(now())

  @@id([walletAddress, conversationId])
  @@index([walletAddress, lastSeenAt])
}

// Phase I.3 — unsigned EIP-712 PaymentAuth payloads prepared by the AI
// ordering layer. The buyer is the address bound to the caller's
// session/OAuth token. The row is short-lived (`expiresAt`, ~30 min) and is
// marked `signedAt` once the buyer's wallet posts the signature via
// /sign/[id]. The `nonce` mirrors v3.2's per-buyer authNonces counter at
// draft time; the sign page re-reads on-chain authNonces before signing
// and refuses if it has moved (which would mean an earlier draft was
// already settled).
model DraftOrder {
  id                  String    @id // 32-byte random, URL-safe
  buyer               String // lowercased 0x address
  seller              String // checksummed (mirrors product.sellerAddress)
  paymentToken        String // 0x0 for native; ERC-20 address otherwise
  productId           String // matches Product.id stringified (no DB FK; products may move chains)
  amount              String // wei (native) or token base units
  nonce               String // PaymentAuth.nonce, stringified uint256
  deadline            DateTime // PaymentAuth.deadline, stored as UTC
  chainId             Int
  marketplaceAddress  String
  productNameSnapshot String    @default("")
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  signedAt            DateTime?
  txHash              String?
  cancelledAt         DateTime?

  @@index([buyer, createdAt(sort: Desc)])
  @@index([expiresAt])
}

// Phase I.3 — OAuth 2.0 authorization codes issued at the end of the SIWE
// landing page (/oauth/connect) and exchanged for a JWT bearer at
// /oauth/token. Bound to (clientId, address, redirectUri) and consumed
// at most once. We don't model long-lived refresh tokens for MVP — when
// the JWT expires, the user re-runs the GPT and SIWE again.
model OAuthAuthorizationCode {
  code                String    @id
  clientId            String
  address             String // lowercased 0x
  redirectUri         String
  scope               String    @default("")
  codeChallenge       String?
  codeChallengeMethod String?
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?

  @@index([expiresAt])
  @@index([address])
}

// Blacklist of buyer/seller/on-chain addresses blocked from the platform.
// Inverse of EVIDENCE_ADMIN_ADDRESSES — admins add entries; the risk engine
// reads them. address is always stored lowercase 0x-hex.
model Blacklist {
  id        Int      @id @default(autoincrement())
  address   String   @unique // lowercase 0x-hex
  reason    String // free text, required (no empty)
  addedBy   String // admin address that added it, lowercase
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// =====================================================================
// v3.3 shop economy indexer tables (Phase K.5a).
// All five models are indexer-maintained — see
// frontend/lib/indexer/v3_3/applyEvent*.ts. Application code reads via
// /api/shops/* + /api/listings and MUST NOT write directly.
// =====================================================================

/// One row per shopId, projected from ShopNFT events (ShopCreated /
/// ShopMetadataUpdated / Transfer). currentOwner advances on every
/// Transfer.
model ShopNFT {
  shopId            Int      @id
  currentOwner      String
  creator           String
  createdAt         DateTime
  name              String   @default("")
  description       String   @default("")
  imageUrl          String   @default("")
  lastUpdatedBlock  BigInt
  lastUpdatedTxHash String

  @@index([currentOwner])
}

/// Current (shopId, holder) balance. Rows with balance=0 are kept so
/// "addresses that ever held shares of shop N" queries work without a
/// separate history table.
model ShopShareHolding {
  shopId           Int
  holder           String
  balance          String
  lastUpdatedBlock BigInt

  @@id([shopId, holder])
  @@index([holder])
  @@index([shopId, balance])
}

/// Audit log for all three RevenueDistributor event kinds. eventType:
/// 0 = Deposited, 1 = Settled, 2 = Claimed. `holder` is null for
/// Deposited; the actor for Settled / Claimed. `token` is
/// 0x0000…0000 (NATIVE sentinel) for native revenue.
model ShopRevenueEvent {
  id          String   @id
  shopId      Int
  eventType   Int
  holder      String?
  token       String
  amount      String
  blockNumber BigInt
  txHash      String
  logIndex    Int      @default(0)
  blockTime   DateTime

  @@unique([txHash, logIndex])
  @@index([shopId, eventType])
  @@index([holder])
  @@index([blockNumber])
}

/// Projection of ShareMarket events. Status: 0 Active / 1 Filled / 2
/// Cancelled. buyer is populated on fill; closed{Block,TxHash} are set
/// on Filled / Cancelled.
model ShopListing {
  listingId       Int     @id
  seller          String
  shopId          Int
  // Legacy K.4 fields. For M.1 listings, `amount` mirrors
  // `originalAmount` and `totalPrice` mirrors
  // `pricePerToken * originalAmount` so older callers still work.
  amount          String
  paymentToken    String
  totalPrice      String
  // M.1 partial-fill fields. Nullable so K.4 rows survive the
  // migration; new rows always populate all three.
  originalAmount  String?
  remainingAmount String?
  pricePerToken   String?
  status          Int
  buyer           String?
  createdBlock    BigInt
  createdTxHash   String
  closedBlock     BigInt?
  closedTxHash    String?

  @@index([seller])
  @@index([shopId, status])
  @@index([status])
}

/// Per-(chainId, contractAddress) catch-up cursor for the four
/// shop-economy contracts. contractType is one of
/// "shopNft" / "shopShares" / "distributor" / "shareMarket" so a
/// single tail query can list all four cursors at a glance.
model IndexerStateV3_3ShopEconomy {
  chainId          Int
  contractAddress  String
  contractType     String
  lastIndexedBlock BigInt
  updatedAt        DateTime @updatedAt

  @@id([chainId, contractAddress])
  @@index([contractType])
}

/// v3.3 order projection (Phase K.5b). Schema mirrors OnChainOrderV3_2
/// plus `shopId` (snapshotted at create time, immutable per the v3.3
/// "investor invariant") and the fee / sellerAmount split written by
/// RevenueDistributed events on order completion.
///
/// Cursor lives in IndexerStateV3_3ShopEconomy with contractType
/// = 'marketplace'. Application code reads via /api/orders/v3_3/...
/// and MUST NOT write directly.
model OnChainOrderV3_3 {
  chainId            Int
  marketplaceAddress String
  onChainOrderId     String
  buyer              String
  seller             String
  shopId             Int
  paymentToken       String
  productId          String
  amount             String
  status             Int
  createdAt          DateTime
  paidAt             DateTime?
  shippedAt          DateTime?
  completedAt        DateTime?
  disputedAt         DateTime?
  feeAmount          String?
  sellerAmount       String?
  // Kleros V2 adapter mirror columns (Phase L.3). Same semantics as the
  // v3.2 mirror — populated by the independent v3.3 KlerosAdapter event
  // stream, which shares IndexerStateV3_3ShopEconomy with contractType
  // = 'klerosAdapter'. `klerosDisputeId` stays TEXT because Kleros V2
  // disputeIds are uint256.
  klerosDisputeId    String?
  disputeEscalatedAt DateTime?
  klerosRuling       Int? // 0 refused → buyer (normalised), 1 buyer, 2 seller
  klerosRuledAt      DateTime?
  lastEventBlock     BigInt
  lastEventTxHash    String
  lastSyncedAt       DateTime @default(now())

  @@id([chainId, marketplaceAddress, onChainOrderId])
  @@index([buyer])
  @@index([seller])
  @@index([shopId])
  @@index([status])
  @@index([chainId, marketplaceAddress])
  @@index([klerosDisputeId])
}
